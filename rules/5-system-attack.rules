#-----------------------------------------------------------------------
# 5XXXXXX  시스템 공격 (Reverse Shell / Shell Command / File Access)
# 웹 계층에서 놓친 공격을 "시스템 계층의 이상 행위"에서 다시 잡는다.
#-----------------------------------------------------------------------

# 리버스 셸 : 서버가 외부로 능동 SYN을 여는 이상 아웃바운드
drop tcp $HTTP_SERVERS any -> $EXTERNAL_NET any ( msg:"WEB SHELL - Outbound TCP Connection"; flow:to_server; flags:S; sid:5001001; rev:1; )
# bash 리버스 셸 페이로드
alert tcp any any -> any any ( msg:"Bash Shell - Command Attempt"; content:"bash -i"; nocase; sid:5001002; rev:1; )
alert tcp any any -> any any ( msg:"Bash Shell - External Connection"; pcre:"/(?:\/dev\/tcp\/|nc\s+-e|ncat\s)/i"; sid:5001003; rev:1; )
# 웹셸 대화형 명령 (raw TCP)
alert tcp any any -> $HTTP_SERVERS any ( msg:"WEB SHELL - Interactive Shell Command Detected in Raw TCP Data"; pcre:"/\b(whoami|id|uname\s+-a|hostname|pwd|cat\s|chmod\s)\b/"; sid:5002001; rev:1; )
# 중요 파일 접근
alert tcp any any -> $HOME_NET any ( msg:"System - Sensitive File Access"; content:"/etc/passwd"; nocase; sid:5003001; rev:1; )
